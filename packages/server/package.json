{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ateam/server",
  "version": "2.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -b -b",
    "typecheck:tsc": "tsc -b"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ateam/core": "workspace:*",
    "@ateam/protocol": "workspace:*",
    "@ateam/schema": "workspace:*",
    "@ateam/simulation": "workspace:*",
    "@ateam/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@opencode/pty": "0.6.0",
    "@ateam/client": "workspace:*",
    "@ateam/plugin": "workspace:*",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:"
  }
}
