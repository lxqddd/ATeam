{
  "name": "@ateam/client-sdk",
  "version": "0.1.1",
  "private": true,
  "description": "TypeScript client for the ATeam headless HTTP API",
  "license": "MIT",
  "author": "ATeam contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxqddd/ATeam.git",
    "directory": "packages/client-sdk"
  },
  "homepage": "https://github.com/lxqddd/ATeam/tree/master/packages/client-sdk#readme",
  "bugs": {
    "url": "https://github.com/lxqddd/ATeam/issues"
  },
  "keywords": [
    "ateam",
    "agent",
    "api",
    "client",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsup",
    "prepack": "pnpm build",
    "pack:check": "pnpm build && node scripts/check-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@ateam/shared": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.1.1",
    "esbuild": "^0.28.0"
  }
}
