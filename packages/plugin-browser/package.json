{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ateam/plugin-browser",
  "version": "2.3.0",
  "description": "OpenCode's desktop browser plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./proxy": "./src/proxy.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.test.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@ateam/plugin": "workspace:*",
    "@ateam/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:"
  }
}
