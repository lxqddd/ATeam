{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ateam/protocol",
  "version": "2.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./simulation": "./src/simulation.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "node --import tsx script/generate-openapi.ts",
    "check:generated": "node --import tsx script/generate-openapi.ts --check",
    "typecheck": "tsc -b",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@ateam/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@typescript/native": "catalog:",
    "prettier": "3.6.2",
    "typescript": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:"
  }
}
