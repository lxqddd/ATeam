{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": [
    "dist",
    "dist-node"
  ],
  "references": [
    {
      "path": "../core"
    }
  ],
  "include": [
    "src"
  ]
}
