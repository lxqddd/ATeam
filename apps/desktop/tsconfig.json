{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "sourceMap": true,
    "noEmit": false,
    "isolatedModules": false
  },
  "include": [
    "src"
  ]
}
