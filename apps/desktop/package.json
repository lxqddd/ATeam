{
  "name": "@ateam/desktop",
  "version": "0.1.1",
  "description": "ATeam desktop application built with Electron, React and TypeScript",
  "homepage": "https://github.com/lxqddd/ATeam",
  "main": "./out/main/index.js",
  "author": "ATeam",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "node scripts/install-electron.mjs && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "bundle:report": "node scripts/bundle-report.mjs",
    "bundle:check": "node scripts/bundle-report.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@electron-toolkit/utils": "^4.0.0",
    "@vscode/ripgrep": "^1.18.0",
    "diff": "8.0.4",
    "gpt-tokenizer": "^4.1.2",
    "turndown": "^7.2.5",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@ateam/shared": "workspace:*",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.1",
    "antd": "6.7.1",
    "electron": "^44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "i18next": "^27.2.1",
    "jsdom": "28.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^18.0.3",
    "react-markdown": "10.1.0",
    "react-router": "^8.5.2",
    "remark-gfm": "4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.1.1",
    "zod": "4.6.7",
    "@ateam/agent-core": "workspace:*"
  }
}
