# Vite reads env files from this directory (the Vite project root).
# Copy to apps/web/.env or .env.local to override the defaults.

# API base URL. Leave as /api to use the Vite dev proxy and the Go server's
# same-origin static hosting.
VITE_API_BASE=/api

# Request timeout in milliseconds; invalid or non-positive values fall back to 30000.
VITE_API_TIMEOUT_MS=30000

# Optional: navigate here when the API returns 401 (e.g. /login).
# VITE_API_UNAUTHORIZED_REDIRECT=/login
