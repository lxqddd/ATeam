{
  "name": "ateam",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @ateam/web dev",
    "dev:desktop": "pnpm --filter @ateam/desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "package": "pnpm --filter @ateam/desktop package"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}
