{
  "name": "ateam",
  "version": "0.1.1",
  "private": true,
  "description": "ATeam — AI Agent desktop workspace",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @ateam/desktop dev",
    "start": "pnpm --filter @ateam/desktop start",
    "cli": "pnpm --filter @ateam/desktop cli",
    "serve": "pnpm --filter @ateam/desktop serve",
    "acp": "pnpm --filter @ateam/desktop acp",
    "build": "pnpm --filter @ateam/desktop build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm --filter @ateam/desktop test",
    "test:watch": "pnpm --filter @ateam/desktop test:watch",
    "test:coverage": "pnpm --filter @ateam/desktop test:coverage",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:unpack": "pnpm --filter @ateam/desktop build:unpack",
    "build:mac": "pnpm --filter @ateam/desktop build:mac",
    "build:win": "pnpm --filter @ateam/desktop build:win",
    "build:linux": "pnpm --filter @ateam/desktop build:linux"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
